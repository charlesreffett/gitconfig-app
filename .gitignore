# ── Go ────────────────────────────────────────────────────────────────────────

# Compiled binaries produced by `go build` at the repo root
/gitconfig-app
/gitconfig-app.exe

# Test binaries produced by `go test -c`
*.test

# Coverage artefacts produced by `go test -coverprofile`
*.out
coverage.html

# ── Wails ─────────────────────────────────────────────────────────────────────

# Production build output — binary + embedded frontend, per platform
/build/

# Wails stores an md5 of package.json to decide whether to re-run `pnpm install`
# before each build; it has no meaning outside the local machine
frontend/package.json.md5

# ── Frontend (Vue / Vite / pnpm) ─────────────────────────────────────────────

# Installed packages — fully reproducible from pnpm-lock.yaml
frontend/node_modules/

# Vite production bundle — generated by `wails build` and embedded into the
# binary via `//go:embed all:frontend/dist`; committing it would create noise
# on every build and inflate history
frontend/dist/

# Vite's incremental transform cache
frontend/.vite/

# ── Environment variables ─────────────────────────────────────────────────────

# May contain API keys, tokens, or local machine paths
.env
.env.local
.env.*.local

# ── IDEs & editors ────────────────────────────────────────────────────────────

# JetBrains (GoLand, WebStorm) — workspace state is local; shared run configs
# can be opted in via `!.idea/runConfigurations/`
.idea/

# VS Code — user-specific settings; shared config can be opted in per-file
.vscode/

# Vim swap / backup files
*.swp
*.swo
*~

# ── macOS ─────────────────────────────────────────────────────────────────────

# Finder metadata files — created automatically on any macOS directory access
.DS_Store
**/.DS_Store

# ── Windows ───────────────────────────────────────────────────────────────────

Thumbs.db
desktop.ini

# ── Tooling ───────────────────────────────────────────────────────────────────

# Claude Code session files — conversation context, not project artefacts
.claude/
